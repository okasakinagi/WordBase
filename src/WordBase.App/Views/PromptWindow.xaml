<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WordBase.App.Views.PromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WordBase">

    <!-- 无标题栏的浮动卡片：整窗用与主窗口同一套 Fluent 画笔，圆角交给 DWM -->
    <Grid x:Name="RootCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid Padding="20,16,20,16" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE823;" FontSize="13"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="该复习了" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="25 秒后收起" FontSize="11" Opacity="0.45"
                           VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="TermText" Grid.Row="1" Margin="0,2,0,0"
                       FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="ReadingText" Grid.Row="2" FontSize="14" Opacity="0.6"
                       TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="3" VerticalAlignment="Bottom" Margin="0,12,0,0"
                       Text="点任意按钮都会进入完整复习（含释义、例句与选择题）"
                       FontSize="11" Opacity="0.45" TextWrapping="Wrap" />

            <Grid Grid.Row="4" Margin="0,10,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <HyperlinkButton Content="打开 WordBase" Click="OnOpenClick" Padding="2,2" FontSize="12" />
                <Button Grid.Column="2" Content="不认识" Click="OnUnknownClick" MinWidth="96" />
                <Button Grid.Column="3" Content="认识" Click="OnKnownClick" MinWidth="96"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
