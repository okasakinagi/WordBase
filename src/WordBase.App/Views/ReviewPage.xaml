<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WordBase.App.Views.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- 空闲态：统计 + 开始复习 + 到期列表 -->
        <Grid x:Name="IdlePanel" Padding="24" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="复习" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Grid.Row="1" Spacing="10">
                <TextBlock Text="{Binding StatsText}" FontSize="14" LineHeight="24" />
                <TextBlock Text="{Binding Message}" Opacity="0.8" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="开始复习" Style="{StaticResource AccentButtonStyle}" Click="OnStartClick" />
                    <Button Content="刷新" Click="OnRefreshClick" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="今日到期" FontWeight="SemiBold" Margin="0,12,0,0" />

            <ListView Grid.Row="3" ItemsSource="{Binding DueItems}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Term}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Readings}" Opacity="0.6" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{Binding PrimaryGloss}" Opacity="0.8" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding State}" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 复习会话：直接在主窗口里展开，不再另开窗口 -->
        <Grid x:Name="SessionPanel" Padding="24" RowSpacing="8" Visibility="Collapsed"
              DataContext="{Binding Session}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ProgressText}" Opacity="0.7" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="结束本轮" Click="OnEndSessionClick" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Left">

                    <TextBlock Text="{Binding Prompt}" FontSize="40" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Reading}" FontSize="17" Opacity="0.7" />

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Success"
                             Message="{Binding Feedback}"
                             Visibility="{Binding FeedbackVisibility}" />

                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{Binding ChoiceVisibility}">
                        <Button Content="不认识" Click="OnUnknownClick" MinWidth="140" Height="44" />
                        <Button Content="认识" Click="OnKnownClick" MinWidth="140" Height="44"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <StackPanel Spacing="10" Visibility="{Binding QuizVisibility}">
                        <TextBlock Text="选一个正确的意思" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding QuizOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Text}" Click="OnOptionClick" Margin="0,4"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="14,10" MinHeight="44" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="10" Visibility="{Binding RevealVisibility}">
                        <TextBlock Text="{Binding AnswerTitle}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding AnswerLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="18" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="例句" FontWeight="SemiBold" Margin="0,8,0,0" Opacity="0.8" />
                        <ItemsControl ItemsSource="{Binding ExampleLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" IsTextSelectionEnabled="True" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding RatingVisibility}" Margin="0,12,0,0">
                            <Button Content="忘记" Tag="Again" Click="OnRateClick" MinWidth="96" />
                            <Button Content="模糊" Tag="Hard" Click="OnRateClick" MinWidth="96" />
                            <Button Content="记得" Tag="Good" Click="OnRateClick" MinWidth="96"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="很轻松" Tag="Easy" Click="OnRateClick" MinWidth="96" />
                        </StackPanel>

                        <Button Content="继续" Click="OnContinueClick" Margin="0,12,0,0"
                                Style="{StaticResource AccentButtonStyle}" MinWidth="120"
                                Visibility="{Binding ContinueVisibility}" />
                    </StackPanel>

                    <StackPanel Spacing="12" Visibility="{Binding DoneVisibility}">
                        <TextBlock Text="{Binding Summary}" FontSize="18" TextWrapping="Wrap" />
                        <Button Content="回到列表" Click="OnEndSessionClick" Style="{StaticResource AccentButtonStyle}"
                                MinWidth="120" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
